# Copie este arquivo para .env e preencha com as chaves do seu projeto Supabase.
# Frontend e backend leem o mesmo .env na raiz (veja os scripts em package.json).

# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role NUNCA vai para o frontend. Só o backend usa.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# E-mails de vocês (donos do SaaS), separados por vírgula.
PLATFORM_ADMIN_EMAILS=voce@turmacerta.com,primo@turmacerta.com
